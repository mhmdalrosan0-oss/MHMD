rules_version = '2';
// Clients may only READ (scoped by role). Every write goes through Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    // Sessions last 7 days from the moment of sign-in (auth_time survives token refreshes), then everything is denied.
    function fresh() { return request.auth.token.get('auth_time', 0) > request.time.toMillis() / 1000 - 604800; }
    function role() { return request.auth != null && fresh() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() == 'staff'; }
    function isCaptain() { return role() == 'captain'; }
    function myGroup() { return request.auth.token.get('groupId', ''); }

    match /settings/{d}  { allow read: if role() != ''; }
    match /groups/{g}    { allow read: if isAdmin() || isStaff() || (isCaptain() && myGroup() == g); }
    match /captains/{c}  { allow read: if isAdmin() || isStaff() || (isCaptain() && request.auth.token.captainId == c); }
    match /staff/{s}     { allow read: if isAdmin(); }
    match /charges/{c}   { allow read: if isAdmin() || isStaff() || (isCaptain() && resource.data.captainId == request.auth.token.captainId); }
    // doc ids are "<groupId>_<YYYY-MM>": matching on the id also works for documents that do not exist yet
    match /stats/{s}     { allow read: if isAdmin() || isStaff() || (isCaptain() && s.matches(myGroup() + '_[0-9]{4}-[0-9]{2}')); }
    match /payouts/{p}   { allow read: if isAdmin() || (isCaptain() && p.matches(myGroup() + '_[0-9]{4}-[0-9]{2}')); }
    match /notifications/{n} {
      allow read: if isAdmin() || (isCaptain() && resource.data.groupId == myGroup()
                   && (resource.data.forCaptains == true || request.auth.token.get('isManager', false) == true));
    }
    match /audit/{a}     { allow read: if isAdmin(); }
    // secrets/*, rl/* and everything else: no client access.
  }
}
